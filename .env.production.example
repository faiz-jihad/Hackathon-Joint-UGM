# ==============================================================================
# RETIVA - Production VPS Environment Configuration
# Salin file ini menjadi .env.production di VPS: cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & URL Konfigurasi
# ------------------------------------------------------------------------------
# Masukkan IP VPS Anda jika belum ada domain (contoh: http://103.187.223.15)
# Atau masukkan domain resmi jika sudah ada (contoh: https://retiva.id)
APP_URL=http://your-vps-ip-or-domain.com

# ------------------------------------------------------------------------------
# 2. Database PostgreSQL (Permenkes No. 24/2022)
# ------------------------------------------------------------------------------
POSTGRES_USER=retiva_admin
# Ganti dengan password acak kuat (minimal 24 karakter)
POSTGRES_PASSWORD=ganti_dengan_password_db_sangat_kuat_32chars!
POSTGRES_DB=retiva_production

# ------------------------------------------------------------------------------
# 3. MinIO S3-Compatible Storage (Penyimpanan Foto Fundus)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=retiva_s3_admin
# Ganti dengan password MinIO yang aman
MINIO_ROOT_PASSWORD=ganti_dengan_password_minio_sangat_kuat_32chars!

# ------------------------------------------------------------------------------
# 4. Keamanan & Autentikasi (JWT & NextAuth)
# ------------------------------------------------------------------------------
# Generate dengan perintah: openssl rand -base64 32
JWT_SECRET=generate_dengan_openssl_rand_base64_32_minimal_32_chars
INTERNAL_API_SECRET=generate_token_rahasia_internal_ai_service_32chars

# ------------------------------------------------------------------------------
# 5. Model AI & Parameter Inferensi
# ------------------------------------------------------------------------------
MODEL_VERSION=efficientnet-b3-v1.0.0
AI_QUALITY_PASS_THRESHOLD=0.75
AI_RELIABILITY_HIGH_THRESHOLD=0.85
AI_RELIABILITY_LOW_THRESHOLD=0.60
