# ==========================================
# RETIVA Core Environment Configuration
# Provider-Agnostic Setup
# ==========================================

# Database (PostgreSQL)
# Works with local PostgreSQL, Docker, AWS RDS, Neon, or Supabase
DATABASE_URL="postgresql://retiva:retivapassword@localhost:5432/retiva_db?schema=public"

# Authentication & Security
JWT_SECRET="retiva-healthcare-jwt-secret-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Storage Provider (S3-Compatible Object Storage)
# Works with AWS S3, Cloudflare R2, MinIO, or Supabase Storage
STORAGE_PROVIDER="s3-compatible"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_PORT=9000
STORAGE_USE_SSL="false"
STORAGE_BUCKET="retiva-fundus-images"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadminpassword"
STORAGE_REGION="us-east-1"

# AI Inference Service (FastAPI)
AI_SERVICE_URL="http://localhost:8003"
AI_INTERNAL_SECRET="retiva-internal-secret-token"

# Model Thresholds (Configurable & Versioned)
MODEL_NAME="efficientnet-b3"
MODEL_VERSION="efficientnet-b3-v1"
AI_QUALITY_PASS_THRESHOLD=0.75
AI_RELIABILITY_HIGH_THRESHOLD=0.85
AI_RELIABILITY_LOW_THRESHOLD=0.60

# Healthcare Interoperability Adapters (Future SATUSEHAT / BPJS)
HEALTHCARE_INTEGRATION_ADAPTER="mock"
SATUSEHAT_BASE_URL=""
SATUSEHAT_CLIENT_ID=""
SATUSEHAT_CLIENT_SECRET=""
