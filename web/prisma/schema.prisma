datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AUTH & USER MANAGEMENT
// ==========================================

enum UserRole {
  PATIENT
  HEALTHCARE_WORKER
  OPHTHALMOLOGIST
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(PATIENT)
  fullName     String    @map("full_name")
  phoneNumber  String?   @map("phone_number")
  facilityId   String?   @map("facility_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  patient             Patient?
  doctorVerification  DoctorVerification?
  facility            Facility?        @relation(fields: [facilityId], references: [id])
  screeningsConducted Screening[]    @relation("ConductedScreenings")
  reviewsConducted   HumanReview[]   @relation("OphthalmologistReviews")
  auditLogs         AuditLog[]       @relation("UserAuditLogs")
  notifications     Notification[]
  incidentsResponded EmergencyIncident[] @relation("IncidentResponder")

  @@map("users")

}

// ==========================================
// 1.1 DOCTOR CREDENTIALS & VERIFICATION
// ==========================================

enum DoctorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KKICheckStatus {
  MATCHED
  UNVERIFIED
  FAILED
}

model DoctorVerification {
  id                String                   @id @default(uuid())
  userId            String?                  @unique @map("user_id")
  fullName          String                   @map("full_name")
  email             String                   @map("email")
  phoneNumber       String                   @map("phone_number")
  sipNumber         String                   @map("sip_number")
  strNumber         String                   @map("str_number")
  primaryFacility   String                   @map("primary_facility")
  subSpecialty      String                   @map("sub_specialty")
  status            DoctorVerificationStatus @default(PENDING)
  kkiCheck          KKICheckStatus           @default(UNVERIFIED) @map("kki_check")
  verificationNotes String?                  @map("verification_notes")
  verifiedBy        String?                  @map("verified_by")
  verifiedAt        DateTime?                @map("verified_at")
  strFileName       String?                  @map("str_file_name")
  sipFileName       String?                  @map("sip_file_name")
  strFileSize       String?                  @map("str_file_size")
  sipFileSize       String?                  @map("sip_file_size")
  strDataUrl        String?                  @map("str_data_url") @db.Text
  sipDataUrl        String?                  @map("sip_data_url") @db.Text
  submittedAt       DateTime                 @default(now()) @map("submitted_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  // Relations
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("doctor_verifications")
}

// ==========================================
// 2. PATIENT & DIABETES PROFILE
// ==========================================

enum Gender {
  MALE
  FEMALE
}

model Patient {
  id               String           @id @default(uuid())
  userId           String?          @unique @map("user_id")
  nik              String           @unique // 16 digit Indonesian National Identification Number
  fullName         String           @map("full_name")
  birthDate        DateTime         @map("birth_date")
  gender           Gender
  phone            String?
  address          String?
  emergencyContact String?          @map("emergency_contact")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  user                  User?                 @relation(fields: [userId], references: [id])
  diabetesProfile       DiabetesProfile?
  screenings            Screening[]
  referrals             Referral[]
  followUps             FollowUp[]
  consultationSummaries ConsultationSummary[]
  carePlans             CarePlan[]
  careReminders         CareReminder[]
  careProgressLogs      CareProgressLog[]
  emergencyIncidents    EmergencyIncident[]
  emergencyContacts     EmergencyContact[]

  @@index([nik])

  @@index([fullName])
  @@map("patients")
}

enum DiabetesType {
  TYPE_1
  TYPE_2
  GESTATIONAL
  UNKNOWN
}

enum TreatmentType {
  INSULIN
  ORAL_MEDICATION
  DIET_AND_LIFESTYLE
  COMBINATION
  NONE
  UNKNOWN
}

model DiabetesProfile {
  id               String         @id @default(uuid())
  patientId        String         @unique @map("patient_id")
  diabetesType     DiabetesType   @default(TYPE_2) @map("diabetes_type")
  yearOfDiagnosis  Int?           @map("year_of_diagnosis")
  currentTreatment TreatmentType  @default(ORAL_MEDICATION) @map("current_treatment")
  lastHbA1c        Float?         @map("last_hba1c")
  lastHbA1cDate    DateTime?      @map("last_hba1c_date")
  systolicBp       Int?           @map("systolic_bp") // mmHg
  diastolicBp      Int?           @map("diastolic_bp") // mmHg
  isSmoker         Boolean        @default(false) @map("is_smoker")
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  patient          Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("diabetes_profiles")
}

// ==========================================
// 3. SCREENING & WORKFLOW STATE MACHINE
// ==========================================

enum ScreeningStatus {
  CREATED
  IMAGE_UPLOADED
  QUALITY_CHECK
  RETAKE_REQUIRED
  AI_ANALYZED
  HUMAN_REVIEW
  SCREENING_COMPLETED
  FOLLOW_UP_REQUIRED
  REFERRAL_RECOMMENDED
  FOLLOW_UP_COMPLETED
}

model Screening {
  id             String          @id @default(uuid())
  patientId      String          @map("patient_id")
  conductedById  String          @map("conducted_by_id")
  facilityId     String?         @map("facility_id")
  status         ScreeningStatus @default(CREATED)
  notes          String?
  metadata       Json?           // Extensible clinical metadata
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  patient        Patient         @relation(fields: [patientId], references: [id])
  conductedBy    User            @relation("ConductedScreenings", fields: [conductedById], references: [id])
  facility       Facility?       @relation(fields: [facilityId], references: [id])
  
  images                RetinalImage[]
  aiResults             AIResult[]
  reliability           ReliabilityAssessment?
  humanReview           HumanReview?
  recommendation        Recommendation?
  referrals             Referral[]
  followUps             FollowUp[]
  consultationSummaries ConsultationSummary[]
  carePlans             CarePlan[]

  @@index([patientId])
  @@index([status])
  @@map("screenings")
}

// ==========================================
// 4. RETINAL IMAGE & QUALITY GATE
// ==========================================

enum EyePosition {
  OD // Oculus Dexter (Mata Kanan)
  OS // Oculus Sinister (Mata Kiri)
}

model RetinalImage {
  id           String        @id @default(uuid())
  screeningId  String        @map("screening_id")
  eye          EyePosition   // Right (OD) or Left (OS)
  storageKey   String        @map("storage_key") // Object storage path (e.g. screenings/id/od.jpg) - NEVER BLOB!
  mimeType     String        @map("mime_type")
  checksum     String        // SHA-256 integrity hash
  fileSizeBytes Int?         @map("file_size_bytes")
  uploadedAt   DateTime      @default(now()) @map("uploaded_at")

  // Relations
  screening    Screening     @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  qualityCheck QualityCheck?

  @@index([screeningId])
  @@map("retinal_images")
}

enum QualityRetakeReason {
  BLURRY
  TOO_DARK
  TOO_BRIGHT
  INSUFFICIENT_FOV
  CATARACT_OPACITY
  OTHER
}

model QualityCheck {
  id                 String               @id @default(uuid())
  retinalImageId     String               @unique @map("retinal_image_id")
  passed             Boolean
  overallScore       Float                @map("overall_score")
  blurScore          Float?               @map("blur_score")
  illuminationScore  Float?               @map("illumination_score")
  fovScore           Float?               @map("fov_score")
  retakeReason       QualityRetakeReason? @map("retake_reason")
  retakeInstructions String?              @map("retake_instructions")
  checkedAt          DateTime             @default(now()) @map("checked_at")

  // Relations
  retinalImage       RetinalImage         @relation(fields: [retinalImageId], references: [id], onDelete: Cascade)

  @@map("quality_checks")
}

// ==========================================
// 5. AI RESULT & MODEL VERSIONING
// ==========================================

enum DRClassification {
  NO_DR             // Stage 0: Tidak ada retinopati diabetik
  MILD_DR           // Stage 1: Retinopati Diabetik Non-Proliferatif Ringan
  MODERATE_DR       // Stage 2: Retinopati Diabetik Non-Proliferatif Sedang
  SEVERE_DR         // Stage 3: Retinopati Diabetik Non-Proliferatif Berat
  PROLIFERATIVE_DR  // Stage 4: Retinopati Diabetik Proliferatif (PDR)
}

model ModelVersion {
  id              String     @id @default(uuid())
  modelName       String     @default("efficientnet-b3") @map("model_name")
  version         String     @unique // e.g. "efficientnet-b3-v1.0.0"
  pipelineVersion String     @map("pipeline_version") // e.g. "dr-pipe-v1.2"
  weightsHash     String     @map("weights_hash") // Integrity checksum of weights
  isActive        Boolean    @default(true) @map("is_active")
  deployedAt      DateTime   @default(now()) @map("deployed_at")

  // Relations
  aiResults       AIResult[]

  @@map("model_versions")
}

model AIResult {
  id                 String           @id @default(uuid())
  screeningId        String           @map("screening_id")
  modelVersionId     String           @map("model_version_id")
  predictedClass     DRClassification @map("predicted_class")
  confidence         Float
  rawProbabilities   Json             @map("raw_probabilities") // Object with probabilities for all 5 classes
  inferenceDurationMs Int?            @map("inference_duration_ms")
  inferenceTimestamp DateTime         @default(now()) @map("inference_timestamp")

  // Relations
  screening          Screening        @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  modelVersion       ModelVersion     @relation(fields: [modelVersionId], references: [id])

  @@index([screeningId])
  @@map("ai_results")
}

// ==========================================
// 6. RELIABILITY GATE & HUMAN REVIEW
// ==========================================

enum ReliabilityStatus {
  ANALYZE       // Reliable -> Auto proceed to recommendation
  HUMAN_REVIEW  // Borderline / Low Confidence -> Specialist review mandatory
  RETAKE        // Degraded or ambiguous image -> Prompt retake
}

model ReliabilityAssessment {
  id                  String            @id @default(uuid())
  screeningId         String            @unique @map("screening_id")
  status              ReliabilityStatus
  score               Float             // Overall composite reliability score [0.0 - 1.0]
  confidenceThreshold Float             @map("confidence_threshold")
  qualityThreshold    Float             @map("quality_threshold")
  reasoning           String?
  assessedAt          DateTime          @default(now()) @map("assessed_at")

  // Relations
  screening           Screening         @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@map("reliability_assessments")
}

enum HumanReviewStatus {
  PENDING
  CONFIRMED_AI
  OVERRIDDEN
}

model HumanReview {
  id             String            @id @default(uuid())
  screeningId    String            @unique @map("screening_id")
  reviewerId     String            @map("reviewer_id")
  reviewStatus   HumanReviewStatus @default(PENDING) @map("review_status")
  confirmedClass DRClassification? @map("confirmed_class")
  clinicalNotes  String?           @map("clinical_notes")
  reviewedAt     DateTime          @default(now()) @map("reviewed_at")

  // Relations
  screening      Screening         @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  reviewer       User              @relation("OphthalmologistReviews", fields: [reviewerId], references: [id])

  @@map("human_reviews")
}

// ==========================================
// 7. RECOMMENDATION ENGINE (RULES-BASED)
// ==========================================

enum RecommendedAction {
  ROUTINE_ANNUAL_SCREENING
  FOLLOW_UP_6_MONTHS
  FOLLOW_UP_3_MONTHS
  SPECIALIST_OPHTHALMOLOGY_REFERRAL
  URGENT_SURGICAL_CONSULTATION
  IMAGE_RETAKE
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Recommendation {
  id                String            @id @default(uuid())
  screeningId       String            @unique @map("screening_id")
  summary           String
  recommendedAction RecommendedAction @map("recommended_action")
  urgencyLevel      UrgencyLevel      @default(LOW) @map("urgency_level")
  referralIndicated Boolean           @default(false) @map("referral_indicated")
  clinicalGuideline String?           @map("clinical_guideline") // e.g. "Perdami 2024 / ADA 2024"
  generatedAt       DateTime          @default(now()) @map("generated_at")

  // Relations
  screening         Screening         @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@map("recommendations")
}

// ==========================================
// 8. HEALTHCARE FACILITY, REFERRAL & FOLLOW-UP
// ==========================================

enum BPJSStatus {
  ACCEPTED
  NOT_AVAILABLE
  NEEDS_CONFIRMATION
}

model Facility {
  id           String              @id @default(uuid())
  name         String
  address      String
  latitude     Float
  longitude    Float
  bpjsStatus   BPJSStatus          @default(NEEDS_CONFIRMATION) @map("bpjs_status")
  isVerified   Boolean             @default(false) @map("is_verified")
  contactPhone String?             @map("contact_phone")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // Relations
  users        User[]
  screenings   Screening[]
  services     FacilityService[]
  insurances   FacilityInsurance[]
  referrals    Referral[]

  @@map("facilities")
}

model FacilityService {
  id          String   @id @default(uuid())
  facilityId  String   @map("facility_id")
  serviceName String   @map("service_name") // e.g. "RETINA_SPECIALIST", "LASER_PHOTOCOAGULATION", "OCT"
  description String?

  // Relations
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("facility_services")
}

model FacilityInsurance {
  id            String   @id @default(uuid())
  facilityId    String   @map("facility_id")
  insuranceName String   @map("insurance_name") // e.g. "BPJS_KESEHATAN", "MANDIRI_INHEALTH"
  status        String   // "ACTIVE", "REQUIRES_PRIOR_AUTHORIZATION"

  // Relations
  facility      Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("facility_insurances")
}

enum ReferralStatus {
  RECOMMENDED
  ISSUED
  ACCEPTED_BY_FACILITY
  PATIENT_ATTENDED
  EXPIRED
  CANCELLED
}

model Referral {
  id               String         @id @default(uuid())
  screeningId      String         @map("screening_id")
  patientId        String         @map("patient_id")
  targetFacilityId String         @map("target_facility_id")
  urgency          UrgencyLevel   @default(MEDIUM)
  reason           String
  clinicalSummary  String         @map("clinical_summary")
  status           ReferralStatus @default(RECOMMENDED)
  issuedAt         DateTime?      @map("issued_at")
  expiresAt        DateTime?      @map("expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  screening        Screening      @relation(fields: [screeningId], references: [id])
  patient          Patient        @relation(fields: [patientId], references: [id])
  targetFacility   Facility       @relation(fields: [targetFacilityId], references: [id])

  @@index([patientId])
  @@index([targetFacilityId])
  @@map("referrals")
}

enum FollowUpStatus {
  SCHEDULED
  REMINDER_SENT
  COMPLETED
  MISSED
  CANCELLED
}

model FollowUp {
  id              String         @id @default(uuid())
  patientId       String         @map("patient_id")
  screeningId     String?        @map("screening_id")
  dueDate         DateTime       @map("due_date")
  status          FollowUpStatus @default(SCHEDULED)
  completionNotes String?        @map("completion_notes")
  completedAt     DateTime?      @map("completed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  patient         Patient        @relation(fields: [patientId], references: [id])
  screening       Screening?     @relation(fields: [screeningId], references: [id])

  @@index([patientId])
  @@index([dueDate])
  @@map("follow_ups")
}

// ==========================================
// 9. AUDIT TRAIL & NOTIFICATIONS
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  action     String   // e.g. "PATIENT_CREATED", "SCREENING_QUALITY_PASSED", "AI_INFERENCE_DONE"
  resource   String   // e.g. "Patient", "Screening", "Referral"
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?    // Detailed diff or context
  timestamp  DateTime @default(now())

  // Relations
  actor      User?    @relation("UserAuditLogs", fields: [actorId], references: [id])

  @@index([action])
  @@index([resource, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String
  status    NotificationStatus  @default(PENDING)
  payload   Json?
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  // Relations
  user      User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// ==========================================
// 10. AGENTIC CARE COMPANION (PRE & POST CONSULTATION)
// ==========================================

enum CareState {
  SCREENING_COMPLETED
  AWAITING_CONSULTATION
  CONSULTATION_RECORDED
  CARE_PLAN_READY
  CARE_PLAN_ACTIVE
  FOLLOW_UP_DUE
  CARE_PLAN_UPDATED
}

enum ConsultationSummarySource {
  PATIENT_REPORTED
  CLINICIAN_DOCUMENT
  TELECONSULTATION_RECORD
}

enum ConsultationVerificationStatus {
  UNVERIFIED_PATIENT_ENTRY
  VERIFIED_WITH_DOCUMENT
  REJECTED_MISMATCH
}

enum CareReminderType {
  CONSULTATION_APPOINTMENT
  MEDICATION
  FOLLOW_UP_VISIT
  LIFESTYLE_CHECK
}

enum CareReminderFrequency {
  ONCE
  DAILY
  WEEKLY
}

model ConsultationSummary {
  id                           String                         @id @default(uuid())
  patientId                    String                         @map("patient_id")
  screeningId                  String?                        @map("screening_id")
  consultationDate             DateTime                       @map("consultation_date")
  hospitalClinicName           String                         @map("hospital_clinic_name")
  doctorName                   String?                        @map("doctor_name")
  doctorFindingsDiagnosis      String                         @map("doctor_findings_diagnosis")
  recommendedTreatment         String?                        @map("recommended_treatment")
  prescribedMedications        Json?                          @map("prescribed_medications")
  followUpDate                 DateTime?                      @map("follow_up_date")
  dietaryLifestyleInstructions String?                        @map("dietary_lifestyle_instructions")
  additionalRestrictions       String?                        @map("additional_restrictions")
  source                       ConsultationSummarySource      @default(PATIENT_REPORTED)
  verificationStatus           ConsultationVerificationStatus @default(UNVERIFIED_PATIENT_ENTRY) @map("verification_status")
  isPatientConfirmed           Boolean                        @default(false) @map("is_patient_confirmed")
  confirmedAt                  DateTime?                      @map("confirmed_at")
  notes                        String?
  createdAt                    DateTime                       @default(now()) @map("created_at")
  updatedAt                    DateTime                       @updatedAt @map("updated_at")

  // Relations
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  screening Screening? @relation(fields: [screeningId], references: [id], onDelete: SetNull)
  carePlans CarePlan[]

  @@index([patientId])
  @@index([screeningId])
  @@map("consultation_summaries")
}

model CarePlan {
  id                     String    @id @default(uuid())
  patientId              String    @map("patient_id")
  consultationSummaryId  String?   @map("consultation_summary_id")
  screeningId            String?   @map("screening_id")
  state                  CareState @default(SCREENING_COMPLETED)
  title                  String
  summary                String
  clinicianInstructions  String?   @map("clinician_instructions")
  aiGeneratedSuggestions String?   @map("ai_generated_suggestions")
  isActive               Boolean   @default(true) @map("is_active")
  activatedAt            DateTime? @map("activated_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationSummary ConsultationSummary? @relation(fields: [consultationSummaryId], references: [id], onDelete: SetNull)
  screening           Screening?           @relation(fields: [screeningId], references: [id], onDelete: SetNull)
  mealPlans           MealPlan[]
  reminders           CareReminder[]
  progressLogs        CareProgressLog[]
  actionAudits        CareActionAudit[]

  @@index([patientId])
  @@index([state])
  @@map("care_plans")
}

model MealPlan {
  id                 String   @id @default(uuid())
  carePlanId         String?  @map("care_plan_id")
  patientId          String   @map("patient_id")
  dailyBudget        Float    @map("daily_budget")
  currency           String   @default("IDR")
  cityRegion         String   @default("Yogyakarta") @map("city_region")
  targetDate         DateTime @default(now()) @map("target_date")
  estimatedTotalCost Float    @map("estimated_total_cost")
  remainingBudget    Float    @map("remaining_budget")
  meals              Json
  shoppingList       Json
  isGeneralEducation Boolean  @default(true) @map("is_general_education")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  carePlan CarePlan? @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@index([carePlanId])
  @@index([patientId])
  @@map("meal_plans")
}

model CareReminder {
  id            String                @id @default(uuid())
  carePlanId    String?               @map("care_plan_id")
  patientId     String                @map("patient_id")
  reminderType  CareReminderType      @map("reminder_type")
  title         String
  description   String?
  scheduledTime DateTime              @map("scheduled_time")
  frequency     CareReminderFrequency @default(ONCE)
  isCompleted   Boolean               @default(false) @map("is_completed")
  completedAt   DateTime?             @map("completed_at")
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  // Relations
  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  carePlan CarePlan? @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([scheduledTime])
  @@map("care_reminders")
}

model CareProgressLog {
  id                String   @id @default(uuid())
  carePlanId        String?  @map("care_plan_id")
  patientId         String   @map("patient_id")
  logDate           DateTime @default(now()) @map("log_date")
  mealsCompleted    Json?    @map("meals_completed")
  medicationsTaken  Json?    @map("medications_taken")
  symptomsReported  String?  @map("symptoms_reported")
  hasUrgentSymptoms Boolean  @default(false) @map("has_urgent_symptoms")
  patientNotes      String?  @map("patient_notes")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  carePlan CarePlan? @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([logDate])
  @@map("care_progress_logs")
}

model CareActionAudit {
  id               String   @id @default(uuid())
  patientId        String   @map("patient_id")
  carePlanId       String?  @map("care_plan_id")
  actionName       String   @map("action_name")
  inputParameters  Json     @map("input_parameters")
  executionResult  Json     @map("execution_result")
  patientConfirmed Boolean  @default(false) @map("patient_confirmed")
  executedAt       DateTime @default(now()) @map("executed_at")
  ipAddress        String?  @map("ip_address")

  // Relations
  carePlan CarePlan? @relation(fields: [carePlanId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([actionName])
  @@index([executedAt])
  @@map("care_action_audits")
}

// ==========================================
// 12. CARE COMPANION MASTER DATA (CRUD ADMIN)
// ==========================================

enum MealCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum GlycemicIndexLevel {
  LOW
  MEDIUM
  HIGH
}

model MasterMealItem {
  id               String             @id @default(uuid())
  name             String
  category         MealCategory
  portion          String             @default("1 porsi")
  estimatedCostIdr Float              @map("estimated_cost_idr")
  glycemicIndex    GlycemicIndexLevel @default(LOW) @map("glycemic_index")
  carbsGrams       Float              @default(20) @map("carbs_grams")
  proteinGrams     Float              @default(15) @map("protein_grams")
  ingredients      String[]           @default([])
  preparationNotes String?            @map("preparation_notes")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([category])
  @@index([isActive])
  @@map("master_meal_items")
}

model MasterDoctorQuestion {
  id           String   @id @default(uuid())
  questionText String   @map("question_text")
  category     String   @default("Umum")
  orderIndex   Int      @default(0) @map("order_index")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isActive])
  @@map("master_doctor_questions")
}

// ==========================================
// 8. RETIVA SOS - AGENTIC EMERGENCY RESPONSE SYSTEM
// ==========================================

enum EmergencyIncidentStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

enum EmergencyUrgencyLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model EmergencyIncident {
  id                  String                  @id @default(uuid())
  patientId           String                  @map("patient_id")
  status              EmergencyIncidentStatus @default(ACTIVE)
  urgencyLevel        EmergencyUrgencyLevel   @default(HIGH) @map("urgency_level")
  
  // Clinical symptoms & context
  symptoms            String[]                @default([])
  reportedContext     Json?                   @map("reported_context")
  initialTrigger      String                  @default("PATIENT_APP_BUTTON") @map("initial_trigger") // PATIENT_APP_BUTTON, WIDGET, QUICK_SHORTCUT, FALL_DETECTED
  
  // Location telemetry
  latitude            Float?
  longitude           Float?
  accuracyMeters      Float?                  @map("accuracy_meters")
  locationTimestamp   DateTime?               @map("location_timestamp")
  locationStatus      String                  @default("PENDING") @map("location_status") // ACCURATE, APPROXIMATE, UNAVAILABLE, PERMISSION_DENIED, STALE
  locationAddress     String?                 @map("location_address")
  secureTrackingToken String?                 @unique @map("secure_tracking_token")
  locationExpiresAt   DateTime?               @map("location_expires_at")
  
  // AI Agent Triage Output
  triageAssessment    Json?                   @map("triage_assessment")
  triageSummary       String?                 @map("triage_summary") @db.Text
  recommendedAction   String?                 @map("recommended_action") @db.Text
  
  // Responder & lifecycle
  responderId         String?                 @map("responder_id")
  acknowledgedAt      DateTime?               @map("acknowledged_at")
  resolvedAt          DateTime?               @map("resolved_at")
  resolutionNotes     String?                 @map("resolution_notes") @db.Text
  
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  // Relations
  patient             Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  responder           User?                   @relation("IncidentResponder", fields: [responderId], references: [id], onDelete: SetNull)
  events              EmergencyIncidentEvent[]
  notifications       EmergencyNotification[]
  followUps           EmergencyFollowUp[]

  @@index([patientId])
  @@index([status])
  @@index([urgencyLevel])
  @@index([createdAt])
  @@map("emergency_incidents")
}

model EmergencyContact {
  id               String   @id @default(uuid())
  patientId        String   @map("patient_id")
  name             String
  relationship     String
  phoneNumber      String   @map("phone_number")
  isPrimary        Boolean  @default(false) @map("is_primary")
  isVerified       Boolean  @default(true) @map("is_verified")
  preferredChannel String   @default("WHATSAPP") @map("preferred_channel")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([isPrimary])
  @@map("emergency_contacts")
}

model EmergencyNotification {
  id                  String            @id @default(uuid())
  incidentId          String            @map("incident_id")
  recipientName       String            @map("recipient_name")
  recipientPhone      String            @map("recipient_phone")
  recipientType       String            @map("recipient_type") // EMERGENCY_CONTACT, PUSKESMAS_DOCTOR, AMBULANCE_119, RS_MATA
  channel             String            // SMS, WHATSAPP, DASHBOARD_PUSH
  message             String            @db.Text
  status              String            @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  failureReason       String?           @map("failure_reason")
  deliveryConfirmedAt DateTime?         @map("delivery_confirmed_at")
  retryCount          Int               @default(0) @map("retry_count")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  // Relations
  incident            EmergencyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([status])
  @@map("emergency_notifications")
}

model EmergencyIncidentEvent {
  id               String            @id @default(uuid())
  incidentId       String            @map("incident_id")
  eventType        String            @map("event_type") // SOS_ACTIVATED, LOCATION_CAPTURED, AI_TRIAGE_COMPLETED, NOTIFICATION_DISPATCHED, ACKNOWLEDGED, NOTE_ADDED, RESOLVED, CANCELLED
  eventTitle       String            @map("event_title")
  eventDescription String?           @map("event_description") @db.Text
  actorType        String            @default("SYSTEM") @map("actor_type") // PATIENT, SYSTEM, DOCTOR, RESPONDER, AI_AGENT
  actorName        String?           @map("actor_name")
  payload          Json?
  createdAt        DateTime          @default(now()) @map("created_at")

  // Relations
  incident         EmergencyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([createdAt])
  @@map("emergency_incident_events")
}

model EmergencyFollowUp {
  id          String            @id @default(uuid())
  incidentId  String            @map("incident_id")
  authorId    String?           @map("author_id")
  authorName  String            @map("author_name")
  authorRole  String            @default("DOCTOR") @map("author_role")
  notes       String            @db.Text
  actionTaken String?           @map("action_taken")
  createdAt   DateTime          @default(now()) @map("created_at")

  // Relations
  incident    EmergencyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("emergency_follow_ups")
}


