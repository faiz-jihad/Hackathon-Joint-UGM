# Database (PostgreSQL)
DATABASE_URL="postgresql://retiva:retivapassword@localhost:5432/retiva_db?schema=public"

# Auth / JWT
JWT_SECRET="retiva-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0 & NextAuth.js
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="retiva-super-secret-jwt-key-change-in-production"

# Storage (MinIO / S3 Compatible)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="retiva-fundus-images"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadminpassword"
STORAGE_USE_SSL="false"

# AI Microservice
AI_SERVICE_URL="http://localhost:8003"
AI_INTERNAL_SECRET="retiva-internal-secret-token"

# Environment (handled automatically by Next.js: development in next dev, production in next build)
# NODE_ENV="development"
